@startuml
left to right direction
skinparam actorStyle awesome

actor "Utilisateur (visiteur)" as U
actor "Administrateur" as A
actor "Timer systemd (horloge)" as T
A --|> U

rectangle "Système CityDataHub" {
  usecase "Consulter les mesures" as UC1
  usecase "Consulter les alertes" as UC2
  usecase "Importer un fichier CSV (authentifie)" as UC3
  usecase "Exécuter la collecte API" as UC4
  usecase "Exécuter la sauvegarde pg_dump" as UC5
  usecase "Restaurer une sauvegarde" as UC6
}

U --> UC1
U --> UC2
A --> UC3
A --> UC4
A --> UC6
T --> UC4
T --> UC5
@enduml
